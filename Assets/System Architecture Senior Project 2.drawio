      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n!theme plain\nskinparam defaultFontName \&quot;JetBrains Mono\&quot;\nskinparam defaultFontSize 12\nskinparam ArrowColor #555555\nskinparam ArrowThickness 1.5\nskinparam RoundCorner 6\nskinparam shadowing false\n\nskinparam actor {\n  BackgroundColor #FFFFFF\n  BorderColor #222222\n  FontColor #222222\n}\n\nskinparam rectangle {\n  BackgroundColor #FFFFFF\n  BorderColor #AAAAAA\n  FontColor #222222\n}\n\nskinparam package {\n  BackgroundColor #FFFFFF\n  BorderColor #444444\n  FontColor #444444\n  FontStyle bold\n}\n\nskinparam database {\n  BackgroundColor #FFFFFF\n  BorderColor #444444\n  FontColor #222222\n}\n\nskinparam cloud {\n  BackgroundColor #FFFFFF\n  BorderColor #444444\n  FontColor #222222\n}\n\nskinparam node {\n  BackgroundColor #FFFFFF\n  BorderColor #888888\n  FontColor #222222\n}\n\n&#39; ─── Actors ───────────────────────────────────────────────\nactor \&quot;Staff / Owner\&quot; as Staff\nactor \&quot;Customer\&quot; as Customer\n\n&#39; ─── Shared Backend ───────────────────────────────────────\ndatabase \&quot;Firestore\&quot; as Firestore\ncloud \&quot;Cloudflare R2\&quot; as R2\n\npackage \&quot;Firebase\&quot; {\n  node \&quot;Client SDK\&quot; as FBClient\n  node \&quot;Admin SDK\&quot;  as FBAdmin\n}\n\npackage \&quot;AWS\&quot; {\n  node \&quot;S3 Client\&quot; as S3\n}\n\n&#39; ─── POS App ──────────────────────────────────────────────\npackage \&quot;POS App  (Next.js)\&quot; {\n  rectangle \&quot;Middleware\\n(Auth Guard)\&quot; as Middleware\n  rectangle \&quot;React Contexts\\n(Client State)\&quot; as Contexts\n  rectangle \&quot;Services Layer\&quot; as Services\n  rectangle \&quot;API Routes\&quot; as POS_API\n}\n\n&#39; ─── Storefront ───────────────────────────────────────────\npackage \&quot;Storefront  (Next.js)\&quot; {\n  rectangle \&quot;TanStack Query\\n(Caching)\&quot; as TanStack\n  rectangle \&quot;Hooks\&quot; as Hooks\n  rectangle \&quot;API Routes\&quot; as SF_API\n}\n\n&#39; ─── POS flows ────────────────────────────────────────────\nStaff        --&gt; Middleware   : requests\nMiddleware   --&gt; Contexts     : authenticated\nContexts     --&gt; Services     : state mutations\nServices     --&gt; FBClient     : read / write\nFBClient     --&gt; Firestore\n\nContexts     --&gt; POS_API      : server actions\nPOS_API      --&gt; FBAdmin      : privileged ops\nFBAdmin      --&gt; Firestore\n\nPOS_API      --&gt; S3           : asset upload\nS3           --&gt; R2           : object storage\n\n&#39; ─── Storefront flows ─────────────────────────────────────\nCustomer     --&gt; TanStack     : browsing\nTanStack     --&gt; Hooks        : cached data\nHooks        --&gt; SF_API       : fetch\nSF_API       --&gt; FBClient     : read-only\nFBClient     --&gt; Firestore\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="iYTH_h-V46xlIaUjBytL-1">
